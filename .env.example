PORT=3000
LOG_LEVEL=info

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=cadena-secreta-para-el-handshake
WHATSAPP_APP_SECRET=app-secret-de-la-app-de-meta
WHATSAPP_ACCESS_TOKEN=token-permanente-del-usuario-del-sistema
WHATSAPP_PHONE_NUMBER_ID=id-numerico-del-numero-de-whatsapp
WHATSAPP_GRAPH_VERSION=v21.0

# Zoho Books
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Cambia el dominio segun tu centro de datos: .com, .eu, .in, .com.au, .jp
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

QUOTE_CURRENCY_SYMBOL=$
QUOTE_SESSION_TTL_MINUTES=60
